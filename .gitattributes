model/onnx/*.onnx filter=lfs diff=lfs merge=lfs -text
# tokenizer.json (~310 KB) and vocab.txt (~94 KB) are regenerated whenever the
# vocab is trimmed against a new training corpus, so they churn alongside the
# ONNX weights. Keep them in LFS so retrains don't bloat git history.
model/tokenizer.json filter=lfs diff=lfs merge=lfs -text
model/vocab.txt filter=lfs diff=lfs merge=lfs -text
apple/RampartCoreML/docs/assets/*.mp4 filter=lfs diff=lfs merge=lfs -text
